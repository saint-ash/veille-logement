# Copie ce fichier en "secrets.env" (uniquement pour un lancement sur ton PC).
# Ne le mets JAMAIS sur GitHub : là-bas, utilise Settings > Secrets.
TELEGRAM_TOKEN=123456789:AAAA-ton-token-BotFather
TELEGRAM_CHAT_ID=123456789
# Optionnel — relais des alertes mail (mot de passe d'application Gmail, pas ton vrai mot de passe)
IMAP_USER=
IMAP_PASSWORD=
# Optionnel — alternative à Telegram
NTFY_TOPIC=
# Optionnel — temps de trajet réels (clé gratuite sur prim.iledefrance-mobilites.fr)
PRIM_API_KEY=
